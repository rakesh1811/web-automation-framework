{
  "name": "web-automation-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework (POM, Allure, Winston) for automationexercise.com login and signup",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test tests/e2e",
    "test:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:html": "playwright show-report playwright-report",
    "clean": "node scripts/clean.mjs",
    "report": "node scripts/report.mjs",
    "report:single": "node scripts/report.mjs --no-open",
    "clear": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.1",
    "allure-playwright": "^3.4.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "winston": "^3.18.3"
  }
}
